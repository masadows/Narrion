QWidget {
    background-color: #1b1e22;
    color: #f0f0f0;
    font-family: "Segoe UI", sans-serif;
    font-size: 14px;
}

/* Nagłówki sekcji */
QGroupBox {
    border: 2px solid #333;
    border-radius: 8px;
    margin-top: 8px;
    background-color: #25282d;
}
QGroupBox::title {
    color: #ccc;
    font-weight: bold;
    subcontrol-origin: margin;
    left: 10px;
}

/* Log */
#logBox {
    background-color: #111;
    border: 1px solid #333;
    color: #00ff99;
    border-radius: 6px;
    font-family: Consolas, monospace;
}

/* Przyciski kości */
QPushButton[diceButton="true"] {
    background-color: #333;
    color: white;
    border-radius: 6px;
    border: 2px solid #555;
    font-weight: bold;
}
QPushButton[diceButton="true"]:hover {
    background-color: #444;
    border-color: #ffaa00;
}
QPushButton[diceButton="true"]:pressed {
    background-color: #ffaa00;
    color: #000;
}

/* Custom */
QPushButton[customButton="true"] {
    background-color: #ff8800;
    color: #000;
    border-radius: 5px;
    font-weight: bold;
    padding: 2px 6px; 
}

QPushButton[customButton="true"]:hover {
    background-color: #ffaa33;
}

/* Małe przyciski (+/-) */
QPushButton[smallButton="true"] {
    width: 24px;
    height: 24px;
    border-radius: 4px;
    background-color: #444;
    border: 1px solid #666;
    font-weight: bold;
}
QPushButton[smallButton="true"]:hover {
    background-color: #555;
}

/* Reset */
QPushButton[resetButton="true"] {
    background-color: #28a745;
    color: white;
    border-radius: 5px;
    font-weight: bold;
}
QPushButton[resetButton="true"]:hover {
    background-color: #34ce57;
}

/* Rzut */
#rollButton {
    background-color: #007bff;
    color: white;
    font-weight: bold;
    font-size: 16px;
    border-radius: 8px;
    padding: 6px;
}
#rollButton:hover {
    background-color: #339cff;
}

/* Licznik */
#countLabel {
    font-size: 18px;
    color: #ffcc00;
    font-weight: bold;
    width: 220px;
    min-height: 50px;
    max-height: 65px;
    margin: 0px; 
    padding: 2px;
}


QLineEdit {
    border: 1px solid #888;
    border-radius: 5px;
    padding: 2px 4px;
    font-size: 14px;
}