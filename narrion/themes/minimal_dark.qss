QWidget { 
    background-color: #1a1a1a; 
    color: #e0e0e0; 
    font-family: 'Consolas', monospace; 
}

QPushButton { 
    background-color: #2a2a2a; 
    border: 1px solid #3a3a3a;
    padding: 6px 10px; 
    border-radius: 4px; 
    color: #e0e0e0;
}

QPushButton:hover { 
    background-color: #3a3a3a; 
}

QPushButton:pressed { 
    background-color: #505050; 
    color: #ffffff;
}

QLabel, 
QGroupBox, 
QHeaderView::section {
    color: #ffffff;
    font-weight: bold;
    background-color: #111111;
    padding: 4px 6px;
    border-radius: 4px;
}

QCheckBox::indicator {
    width: 36px;
    height: 18px;
    background-color: #444;
    border-radius: 9px;
    border: 1px solid #666;
}
QCheckBox::indicator:checked {
    background-color: #eee;
}

QGroupBox {
    border: 1px solid #333;
    background-color: #1f1f1f;
    border-radius: 6px;
}

QGroupBox::title {
    font-weight: bold;
    color: #cccccc;
}

#logBox {
    background-color: #111;
    border: 1px solid #333;
    color: #dddddd;
    font-family: Consolas, monospace;
}

QPushButton[diceButton="true"] {
    background-color: #2a2a2a;
    border: 1px solid #555;
    font-weight: bold;
    color: #e0e0e0;
}
QPushButton[diceButton="true"]:hover {
    background-color: #3a3a3a;
    border-color: #777;
}
QPushButton[diceButton="true"]:pressed {
    background-color: #eee;
    color: #000;
}

QPushButton[customButton="true"] {
    background-color: #444;
    color: #f0f0f0;
    font-weight: bold;
}
QPushButton[customButton="true"]:hover {
    background-color: #555;
}

QPushButton[smallButton="true"] {
    background-color: #333;
    border: 1px solid #555;
    color: #e0e0e0;
    font-weight: bold;
}
QPushButton[smallButton="true"]:hover {
    background-color: #444;
}

QPushButton[resetButton="true"] {
    background-color: #e0e0e0;
    color: #111;
    font-weight: bold;
}
QPushButton[resetButton="true"]:hover {
    background-color: #f5f5f5;
}

#rollButton {
    background-color: #444;
    color: #ffffff;
    font-weight: bold;
    font-size: 16px;
    border-radius: 4px;
}
#rollButton:hover {
    background-color: #555;
}

#countLabel {
    font-size: 18px;
    color: #ffffff;
    font-weight: bold;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 2px 6px;
    background-color: #222;
}

QPushButton#menuButtons {
    padding: 10px 14px;
    text-align: left;
    border: none;
    background-color: transparent;
    color: #cccccc;
    font-size: 14px;
}

QPushButton#menuButtons:hover {
    background-color: #333;
    color: #ffffff;
}

QPushButton#menuButtons:checked {
    background-color: #555;
    color: #ffffff;
    font-weight: bold;
}

QListWidget::item {
    border-radius: 8px;
    padding: 10px;
    margin: 6px;
    border: 1px solid #000;
}

QListWidget::item:hover {
    background-color: #3a3a3a;
}

QListWidget::item:selected {
    background-color: #292929;
}

QCalendarWidget {
    background-color: #1a1a1a;
    border: 1px solid #333;
    color: #e0e0e0;
    border-radius: 6px;
}

QCalendarWidget QToolButton {
    background-color: #2a2a2a;
    color: #ffffff;
    border: 1px solid #444;
    border-radius: 4px;
    height: 24px;
    font-weight: bold;
}

QCalendarWidget QToolButton:hover {
    background-color: #3a3a3a;
}

QCalendarWidget QToolButton:pressed {
    background-color: #505050;
}

QCalendarWidget QMenu {
    background-color: #1a1a1a;
    color: #ffffff;
    border: 1px solid #444;
}

QCalendarWidget QSpinBox {
    background-color: #2a2a2a;
    color: #ffffff;
    border: 1px solid #444;
    border-radius: 4px;
}
QCalendarWidget QSpinBox::up-button,
QCalendarWidget QSpinBox::down-button {
    subcontrol-origin: border;
    width: 16px;
    height: 12px;
    border-left: 1px solid #555;
}


QCalendarWidget QAbstractItemView {
    background-color: #1a1a1a;
    color: #e0e0e0;
    selection-background-color: #444;
    selection-color: #ffffff;
    gridline-color: #333;
    outline: none;
}


QCalendarWidget QWidget {
    alternate-background-color: #222;
}


QCalendarWidget QTableView {
    color: #e0e0e0;
    background-color: #1a1a1a;
    gridline-color: #333;
}


QCalendarWidget QTableView::item {
    background-color: #1a1a1a;
    color: #e0e0e0;
}


QCalendarWidget QTableView::item:hover {
    background-color: #2a2a2a;
}

QCalendarWidget QTableView::item:selected {
    background-color: #555;
    color: #ffffff;
}


QCalendarWidget QTableView QHeaderView::section {
    background-color: #1a1a1a;
    color: #cccccc;
    border: none;

}

QTreeWidget {
    background-color: #1a1a1a;
    color: #e0e0e0;
    border: 1px solid #333;
    outline: 0;
}

QTreeWidget::item {
    color: #e0e0e0;
}

QTreeWidget::item:hover {
    background-color: #2a2a2a;
    color: #ffffff;
}

QTreeWidget::item:selected {
    background-color: #444;
    color: #ffffff;
    border: none;
}

QTreeWidget::item:selected:active {
    background-color: #505050;
}

QToolButton {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    color: #e0e0e0;
    padding: 4px;
}

QToolButton:hover {
    background-color: #3a3a3a;
    border-color: #555;
}

QToolButton:checked {
    background-color: #505050;
    border: 1px solid #666;
    color: #ffffff;
}

QToolButton:pressed {
    background-color: #111;
}

QTextEdit {
    border: 1px solid #333;
    background-color: #111;
    color: #e0e0e0;
    font-family: 'Consolas', monospace;
    selection-background-color: #444;
    selection-color: #ffffff;
}

QWidget {
    selection-background-color: #555;
    selection-color: #ffffff;
}