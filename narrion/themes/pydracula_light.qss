/* icon-color: #6b57b8; */

QWidget {
    background-color: #f7f6ff;
    color: #2a2a3b;
    font-family: 'Segoe UI', 'Roboto', sans-serif;
}

QMenuBar, QMenu, QGroupBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #e7e4ff, stop:1 #d3cff7);
    color: #453c9e;
    font-weight: bold;
    border: 1px solid #b8b3e6;
    border-radius: 6px;
    padding: 4px 8px;
}

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #edeaff, stop:1 #d8d4f7);
    border: 1px solid #a6a0dc;
    border-radius: 6px;
    padding: 6px 12px;
    color: #2a2a3b;
    font-weight: 600;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #e0dcff, stop:1 #c9c4f0);
}
QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #bbb4e0, stop:1 #a39bd1);
}

QPushButton[diceButton="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #d8d4f7, stop:1 #c1bcf0);
    border: 2px solid #9b96d8;
    color: #2a2a3b;
    font-weight: bold;
}
QPushButton[diceButton="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #cfcaf0, stop:1 #b7b2e6);
    border-color: #7d77c6;
}
QPushButton[diceButton="true"]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #aaa4d6, stop:1 #928cc3);
}

QPushButton[smallButton="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f0edff, stop:1 #dbd7f8);
    border: 1px solid #b3aee3;
    color: #2a2a3b;
    font-weight: bold;
}
QPushButton[smallButton="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #e4e0ff, stop:1 #ccc8f2);
}
QPushButton[resetButton="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #91f7a8, stop:1 #76ec91);
    color: #112;
    font-weight: bold;
}
QPushButton[resetButton="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #7aef94, stop:1 #64e37d);
}

#rollButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #c9c4f0, stop:1 #b0a9e0);
    color: #1a1a2a;
    font-weight: bold;
    font-size: 16px;
    border-radius: 6px;
    border: 1px solid #9a94d6;
}
#rollButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #dbd7f8, stop:1 #bfb8eb);
}

QLabel, QGroupBox, QHeaderView::section {
    color: #453c9e;
    font-weight: bold;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f3f1ff, stop:1 #e2def7);
    padding: 4px 6px;
    border-radius: 4px;
    border: 1px solid #b8b3e6;
}

QListWidget::item {
    border-radius: 12px;
    padding: 20px;
    margin: 8px;
    min-width: 160px;
    min-height: 80px;
    text-align: center;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f2f0ff, stop:1 #d8d4f7);
    border: 1px solid #b3aee3;
    color: #2a2a3b;
}
QListWidget::item:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #e7e4ff, stop:1 #ccc8f2);
    border: 1px solid #8c87cf;
}
QListWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #d1ccf3, stop:1 #bcb7e8);
    border: 1px solid #7a74c3;
    color: #1a1a2a;
}
QListWidget:focus {
    outline: none;
}

QCheckBox::indicator {
    width: 40px;
    height: 20px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #ccc8f2, stop:1 #d7b8f0);
    border-radius: 10px;
}

QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #a58cf0, stop:1 #8b6fe0);
}

#logBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f1efff, stop:1 #e2def7);
    border: 1px solid #b3aee3;
    color: #228822;
    font-family: Consolas, monospace;
}

QTabWidget::pane {
    border: 1px solid #c4c0e0;
    border-radius: 6px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #fafaff, stop:1 #ebeaf7);
    margin-top: 2px;
}
QTabBar::tab {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f4f2ff, stop:1 #e1def5);
    color: #4c4c8a;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border: 1px solid #b6b2df;
    border-bottom: none;
    min-width: 100px;
    margin-right: 2px;
    font-weight: bold;
}
QTabBar::tab:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #eceaff, stop:1 #d5d3f2);
    color: #302d6f;
}
QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #d5d3f2, stop:1 #c3c1e6);
    color: #302d6f;
    border-color: #b6b2df;
    border-bottom: 1px solid #fafaff; 
    font-weight: bold;
}
QTabBar::tab:!selected {
    margin-top: 4px;
}

QPushButton#menuButtons {
    padding: 12px;
    text-align: left;
    border: none;
    background-color: transparent;
    color: #4c4c8a;
    font-size: 14px;
}
QPushButton#menuButtons:hover {
    background-color: #d8d4f7;
    color: #1a1a2a;
}
QPushButton#menuButtons:checked {
    background-color: #bcb7e8;
    color: #222;
    font-weight: bold;
}
